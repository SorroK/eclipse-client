{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eclipse Client",
  "version": "1.1.1",
  "identifier": "com.eclipseclient.launcher",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Eclipse Client",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#080b0e",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://cdn.modrinth.com https://cdn-raw.modrinth.com; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "copyright": "Copyright © 2026 Eclipse Client",
    "category": "Game",
    "shortDescription": "A Rust-powered Minecraft launcher",
    "longDescription": "Eclipse Client is a custom Minecraft launcher with Fabric, Forge, and NeoForge modpacks, .mrpack imports, and Modrinth content.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
